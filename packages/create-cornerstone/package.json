{
  "name": "create-cornerstone",
  "version": "0.1.0",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <25"
  },
  "bin": {
    "create-cornerstone": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/cornerstone.config.schema.json": "./schemas/cornerstone.config.schema.json",
    "./schemas/manifest.lock.schema.json": "./schemas/manifest.lock.schema.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-templates.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test:unit": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
