{
  "name": "@cornerstone/api-client",
  "version": "0.1.0",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test:unit": "pnpm build && node --test test/*.test.mjs",
    "client:generate": "node scripts/generate-client.mjs generate",
    "client:check": "node scripts/generate-client.mjs check"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
