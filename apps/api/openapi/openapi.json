{
  "components": {
    "schemas": {
      "AcceptedResponseDto": {
        "additionalProperties": false,
        "properties": { "accepted": { "example": true, "type": "boolean" } },
        "required": ["accepted"],
        "type": "object"
      },
      "ApiErrorDetailDto": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "VALIDATION_FAILED",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "VERSION_MISMATCH",
              "IDEMPOTENCY_KEY_REUSED",
              "RATE_LIMITED",
              "SERVICE_UNAVAILABLE",
              "INTERNAL_ERROR"
            ],
            "example": "VALIDATION_FAILED",
            "type": "string"
          },
          "message": {
            "example": "The request could not be processed.",
            "type": "string"
          },
          "requestId": {
            "example": "request_123",
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": ["code", "message", "requestId"],
        "type": "object"
      },
      "ApiErrorResponseDto": {
        "additionalProperties": false,
        "properties": {
          "error": { "$ref": "#/components/schemas/ApiErrorDetailDto" }
        },
        "required": ["error"],
        "type": "object"
      },
      "AuthenticatedUserResponseDto": {
        "additionalProperties": false,
        "properties": {
          "user": { "$ref": "#/components/schemas/UserResponseDto" }
        },
        "required": ["user"],
        "type": "object"
      },
      "ChangePasswordRequestDto": {
        "additionalProperties": false,
        "properties": {
          "currentPassword": {
            "format": "password",
            "maxLength": 128,
            "type": "string",
            "writeOnly": true
          },
          "newPassword": {
            "format": "password",
            "maxLength": 128,
            "minLength": 12,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": ["currentPassword", "newPassword"],
        "type": "object"
      },
      "ConfirmRecentAuthRequestDto": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "format": "password",
            "maxLength": 128,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": ["password"],
        "type": "object"
      },
      "CsrfResponseDto": {
        "additionalProperties": false,
        "properties": {
          "csrfToken": { "maxLength": 256, "minLength": 32, "type": "string" }
        },
        "required": ["csrfToken"],
        "type": "object"
      },
      "EmailRequestDto": {
        "additionalProperties": false,
        "properties": {
          "email": { "format": "email", "maxLength": 254, "type": "string" }
        },
        "required": ["email"],
        "type": "object"
      },
      "HealthResponseDto": {
        "additionalProperties": false,
        "properties": {
          "status": { "enum": ["ok", "not-ready"], "type": "string" }
        },
        "required": ["status"],
        "type": "object"
      },
      "LoginRequestDto": {
        "additionalProperties": false,
        "properties": {
          "email": { "format": "email", "maxLength": 254, "type": "string" },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 12,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": ["email", "password"],
        "type": "object"
      },
      "RefreshResponseDto": {
        "additionalProperties": false,
        "properties": { "refreshed": { "example": true, "type": "boolean" } },
        "required": ["refreshed"],
        "type": "object"
      },
      "RegisterRequestDto": {
        "additionalProperties": false,
        "properties": {
          "email": { "format": "email", "maxLength": 254, "type": "string" },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 12,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": ["email", "password"],
        "type": "object"
      },
      "ResetPasswordRequestDto": {
        "additionalProperties": false,
        "properties": {
          "newPassword": {
            "format": "password",
            "maxLength": 128,
            "minLength": 12,
            "type": "string",
            "writeOnly": true
          },
          "token": {
            "maxLength": 1024,
            "minLength": 32,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": ["token", "newPassword"],
        "type": "object"
      },
      "SessionListResponseDto": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": { "$ref": "#/components/schemas/SessionResponseDto" },
            "type": "array"
          }
        },
        "required": ["items"],
        "type": "object"
      },
      "SessionResponseDto": {
        "additionalProperties": false,
        "properties": {
          "absoluteExpiresAt": { "format": "date-time", "type": "string" },
          "current": { "example": false, "type": "boolean" },
          "deviceLabel": {
            "maxLength": 120,
            "nullable": true,
            "type": "string"
          },
          "id": { "format": "uuid", "type": "string" },
          "idleExpiresAt": { "format": "date-time", "type": "string" },
          "lastSeenAt": { "format": "date-time", "type": "string" }
        },
        "required": [
          "id",
          "deviceLabel",
          "lastSeenAt",
          "idleExpiresAt",
          "absoluteExpiresAt",
          "current"
        ],
        "type": "object"
      },
      "UpdateUserRoleRequestDto": {
        "additionalProperties": false,
        "properties": {
          "role": { "enum": ["user", "admin"], "type": "string" }
        },
        "required": ["role"],
        "type": "object"
      },
      "UpdateUserStatusRequestDto": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": ["pending_verification", "active", "suspended", "deleted"],
            "type": "string"
          }
        },
        "required": ["status"],
        "type": "object"
      },
      "UserListResponseDto": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": { "$ref": "#/components/schemas/UserResponseDto" },
            "type": "array"
          },
          "page": { "example": 1, "minimum": 1, "type": "number" },
          "pageSize": {
            "example": 20,
            "maximum": 100,
            "minimum": 1,
            "type": "number"
          },
          "total": { "example": 42, "minimum": 0, "type": "number" }
        },
        "required": ["items", "page", "pageSize", "total"],
        "type": "object"
      },
      "UserResponseDto": {
        "additionalProperties": false,
        "properties": {
          "createdAt": { "format": "date-time", "type": "string" },
          "email": { "format": "email", "maxLength": 254, "type": "string" },
          "emailVerifiedAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "id": { "format": "uuid", "type": "string" },
          "role": { "enum": ["user", "admin"], "type": "string" },
          "status": {
            "enum": ["pending_verification", "active", "suspended", "deleted"],
            "type": "string"
          },
          "updatedAt": { "format": "date-time", "type": "string" },
          "version": { "minimum": 0, "type": "number" }
        },
        "required": [
          "id",
          "email",
          "status",
          "role",
          "version",
          "emailVerifiedAt",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "VerifyEmailRequestDto": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "maxLength": 1024,
            "minLength": 32,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": ["token"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "csrfCookie": {
        "in": "cookie",
        "name": "__Host-cs_csrf",
        "type": "apiKey"
      },
      "csrfHeader": {
        "description": "Session-bound CSRF token for unsafe cookie-auth requests.",
        "in": "header",
        "name": "X-CSRF-Token",
        "type": "apiKey"
      },
      "preauthCsrfCookie": {
        "in": "cookie",
        "name": "__Host-cs_preauth_csrf",
        "type": "apiKey"
      },
      "refreshCookie": {
        "in": "cookie",
        "name": "__Host-cs_refresh",
        "type": "apiKey"
      },
      "sessionCookie": {
        "in": "cookie",
        "name": "__Host-cs_access",
        "type": "apiKey"
      }
    }
  },
