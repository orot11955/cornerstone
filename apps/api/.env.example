NODE_ENV=development

PORT=4000
TRUST_PROXY_HOPS=0
WEB_URL=http://localhost:3000

DATABASE_URL=postgresql://cornerstone_dev_app:cornerstone-dev-app@localhost:5432/cornerstone_dev
DATABASE_MIGRATION_URL=postgresql://cornerstone_dev_migrator:cornerstone-dev-migrator@localhost:5432/cornerstone_dev
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=20
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
MIGRATION_LOCK_WAIT_MS=5000

JWT_ACCESS_SECRET=change-this-at-least-32-characters
JWT_REFRESH_SECRET=change-this-at-least-32-characters
