{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test test/*.test.mjs",
    "test:e2e": "pnpm --filter \"web^...\" build && playwright test",
    "test:e2e:auth": "pnpm --filter \"web^...\" build && playwright test --config playwright.auth.config.ts",
    "budget:check": "node ../../scripts/check-web-budget.mjs"
  },
  "dependencies": {
    "@cornerstone/api-client": "workspace:^",
    "@cornerstone/ui": "workspace:^",
    "@tanstack/react-query": "5.101.4",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cornerstone/tsconfig": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
