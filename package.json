{
  "name": "cornerstone",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm test:unit && pnpm test:component && pnpm test:integration",
    "test:unit": "node scripts/test-scope.mjs test:unit --run",
    "test:component": "node scripts/test-scope.mjs test:component --run",
    "test:integration": "node scripts/run-database-suite.mjs test:integration",
    "test:e2e": "node scripts/run-database-suite.mjs test:e2e",
    "package:check": "node scripts/validate-package-boundaries.mjs",
    "package:verify": "node scripts/verify-package-consumer.mjs",
    "generator:verify": "node scripts/verify-generator-consumer.mjs",
    "web:budget:check": "node scripts/check-web-budget.mjs",
    "db:dev:up": "docker compose -f infra/compose/compose.dev.yml up -d --wait",
    "db:dev:down": "docker compose -f infra/compose/compose.dev.yml down",
    "db:test:up": "docker compose -f infra/compose/compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f infra/compose/compose.test.yml down",
    "migration:show": "pnpm --filter api migration:show",
    "migration:run": "pnpm --filter api migration:run",
    "migration:revert": "pnpm --filter api migration:revert",
    "migration:check": "node scripts/validate-migrations.mjs",
    "database:verify": "pnpm --filter api database:verify",
    "database:backup:verify": "node scripts/verify-logical-backup.mjs",
    "retention:cleanup": "pnpm --filter api retention:cleanup",
    "openapi:generate": "pnpm --filter api openapi:generate",
    "openapi:check": "pnpm --filter api openapi:check",
    "openapi:compat": "node scripts/check-openapi-compatibility.mjs check",
    "openapi:baseline:update": "node scripts/check-openapi-compatibility.mjs update-baseline",
    "client:generate": "pnpm --filter @cornerstone/api-client client:generate",
    "client:check": "pnpm --filter @cornerstone/api-client client:check",
    "seed": "pnpm --filter api seed",
    "license:check": "node scripts/check-package-licenses.mjs",
    "governance:check": "node scripts/validate-governance.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs --history --self-test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript": "5.9.3"
  }
}
