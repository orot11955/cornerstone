  "engines": {
    "node": "24.18.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm test:unit && pnpm test:component && pnpm test:integration",
    "test:unit": "node scripts/test-scope.mjs test:unit --run",
    "test:component": "node scripts/test-scope.mjs test:component --run",
    "test:integration": "node scripts/test-scope.mjs test:integration --run",
    "test:e2e": "node scripts/test-scope.mjs test:e2e --run",
    "package:check": "node scripts/validate-package-boundaries.mjs",
    "package:verify": "node scripts/verify-package-consumer.mjs",
    "license:check": "node scripts/check-package-licenses.mjs",
    "governance:check": "node scripts/validate-governance.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs --history --self-test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
