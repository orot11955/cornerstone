{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["pnpm-lock.yaml"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },

    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },

    "lint": {
      "dependsOn": ["^lint"]
    },

    "typecheck": {
      "dependsOn": ["^build"]
    },

    "test:unit": {
      "dependsOn": ["^test:unit"]
    },

    "test:component": {
      "dependsOn": ["^test:component"]
    },

    "test:integration": {
      "dependsOn": ["^test:integration"],
      "cache": false
    },

    "test:e2e": {
      "dependsOn": ["^test:e2e"],
      "cache": false
    }
  }
}
