{
  "schemaVersion": 1,
  "templateVersion": "0.4.0",
  "profiles": {
    "standard": {
      "capabilities": ["api", "auth", "database", "ui", "web"],
      "certification": {
        "matrix": "standard-preview-node24-pg17",
        "status": "supported"
      }
    }
  },
  "fragments": [
    {
      "id": "base",
      "version": 1,
      "mappings": [
        { "source": ".editorconfig" },
        { "source": ".gitignore" },
        { "source": ".node-version" },
        { "source": ".nvmrc" },
        { "source": ".prettierignore" },
        { "source": ".prettierrc" },
        { "source": "pnpm-lock.yaml" },
        { "source": "scripts/check-openapi-compatibility.mjs" },
        { "source": "scripts/check-package-licenses.mjs" },
        { "source": "scripts/check-web-budget.mjs" },
        { "source": "scripts/run-database-suite.mjs" },
        { "source": "scripts/scan-secrets.mjs" },
        { "source": "scripts/test-scope.mjs" },
        { "source": "scripts/validate-package-boundaries.mjs" },
        { "source": "scripts/validate-governance.mjs" },
        { "source": "scripts/validate-migrations.mjs" },
        { "source": "scripts/verify-logical-backup.mjs" },
        { "source": "scripts/verify-package-consumer.mjs" },
        { "source": ".github/CODEOWNERS" },
        { "source": "docs/adr" },
        { "source": "docs/cornerstone_assembly_diagram.md" },
        { "source": "docs/identity_data_contract.md" },
        { "source": "docs/governance" },
        { "source": "packages/config" },
        { "source": "packages/eslint-config" },
        { "source": "packages/schemas" },
        { "source": "packages/tsconfig" },
        { "source": "packages/types" },
        { "source": "packages/utils" }
      ]
    },
    {
      "id": "api",
      "version": 1,
      "mappings": [
        {
          "source": "apps/api",
          "exclude": [
            "apps/api/src/app.module.ts",
            "apps/api/release/auth-password-policy.json",
            "apps/api/src/auth",
            "apps/api/src/authorization",
            "apps/api/src/contracts",
            "apps/api/src/database",
            "apps/api/src/identity",
            "apps/api/src/users",
            "apps/api/test/database.integration-spec.ts",
            "apps/api/tsconfig.admin-bootstrap.json"
          ]
        },
        { "source": "packages/api-client" }
      ]
    },
    {
      "id": "auth",
      "version": 1,
      "mappings": [
        { "source": "apps/api/release/auth-password-policy.json" },
        { "source": "apps/api/src/auth" },
        {
          "source": "apps/api/src/authorization",
          "exclude": ["apps/api/src/authorization/route-policy.ts"]
        },
        {
          "source": "apps/api/src/contracts",
          "exclude": ["apps/api/src/contracts/api-contract.module.ts"]
        },
        { "source": "apps/api/src/identity" },
        { "source": "apps/api/src/users" }
      ]
    },
    {
      "id": "database",
      "version": 1,
      "mappings": [
        { "source": "apps/api/src/database" },
        { "source": "apps/api/test/database.integration-spec.ts" },
        { "source": "apps/api/tsconfig.admin-bootstrap.json" },
        { "source": "infra/compose" }
      ]
    },
    {
      "id": "ui",
      "version": 1,
      "mappings": [{ "source": "packages/ui" }]
    },
    {
      "id": "web",
      "version": 1,
      "mappings": [{ "source": "apps/web", "exclude": ["apps/web/AGENTS.md"] }]
    },
    { "id": "observability", "version": 1, "mappings": [] },
    { "id": "privacy", "version": 1, "mappings": [] }
  ],
  "composers": [
    {
      "id": "root-package-json",
      "version": 1,
      "format": "package-json",
      "output": "package.json",
      "source": "package.json"
    },
    {
      "id": "pnpm-workspace",
      "version": 1,
      "format": "yaml",
      "output": "pnpm-workspace.yaml",
      "source": "pnpm-workspace.yaml"
    },
    {
      "id": "turbo-json",
      "version": 1,
      "format": "json",
      "output": "turbo.json",
      "source": "turbo.json"
    },
    {
      "id": "test-scope-json",
      "version": 1,
      "format": "test-scope",
      "output": "test-scope.json",
      "source": "test-scope.json"
    },
    {
      "id": "ci-workflow",
      "version": 1,
      "format": "ci-workflow",
      "output": ".github/workflows/ci.yml",
      "source": ".github/workflows/ci.yml"
    },
    {
      "id": "api-app-module",
      "version": 1,
      "format": "nest-module",
      "output": "apps/api/src/app.module.ts",
      "nestModule": {
        "imports": [
          { "names": ["Module"], "from": "@nestjs/common" },
          { "names": ["ConfigModule"], "from": "@nestjs/config" },
          { "names": ["APP_FILTER", "APP_INTERCEPTOR"], "from": "@nestjs/core" },
          { "names": ["AuthModule"], "from": "./auth/auth.module.js" },
          { "names": ["configuration"], "from": "./config/configuration.js" },
          { "names": ["validateEnvironment"], "from": "./config/env.schema.js" },
          { "names": ["DatabaseModule"], "from": "./database/database.module.js" },
          { "names": ["ApiExceptionFilter"], "from": "./http/api-exception.filter.js" },
          { "names": ["HealthModule"], "from": "./health/health.module.js" },
          { "names": ["ObservabilityModule"], "from": "./observability/observability.module.js" },
          {
            "names": ["RequestLoggingInterceptor"],
            "from": "./observability/request-logging.interceptor.js"
          },
          { "names": ["UsersModule"], "from": "./users/users.module.js" }
        ],
        "moduleImports": [
          {
            "kind": "config-for-root",
            "module": "ConfigModule",
            "isGlobal": true,
            "cache": true,
            "load": "configuration",
            "validate": "validateEnvironment"
          },
          { "kind": "identifier", "name": "ObservabilityModule" },
          { "kind": "identifier", "name": "DatabaseModule" },
          { "kind": "identifier", "name": "HealthModule" },
          { "kind": "identifier", "name": "AuthModule" },
          { "kind": "identifier", "name": "UsersModule" }
        ],
        "controllers": [],
        "providers": [
          { "provide": "APP_FILTER", "useClass": "ApiExceptionFilter" },
          { "provide": "APP_INTERCEPTOR", "useClass": "RequestLoggingInterceptor" }
        ],
        "className": "AppModule"
      }
    },
    {
      "id": "api-contract-module",
      "version": 1,
      "format": "nest-module",
      "output": "apps/api/src/contracts/api-contract.module.ts",
      "nestModule": {
        "imports": [
          { "names": ["Module"], "from": "@nestjs/common" },
          { "names": ["HealthModule"], "from": "../health/health.module.js" },
          {
            "names": ["AuthContractController"],
            "from": "./auth-contract.controller.js"
          },
          {
            "names": ["UserContractController"],
            "from": "./user-contract.controller.js"
          }
        ],
        "moduleImports": [{ "kind": "identifier", "name": "HealthModule" }],
        "controllers": ["AuthContractController", "UserContractController"],
        "providers": [],
        "className": "ApiContractModule"
      }
    },
    {
      "id": "api-route-policy",
      "version": 1,
      "format": "typescript-source",
      "output": "apps/api/src/authorization/route-policy.ts",
      "source": "apps/api/src/authorization/route-policy.ts"
    },
    {
      "id": "project-readme",
      "version": 2,
      "format": "readme",
      "output": "README.md"
    },
    {
      "id": "notice",
      "version": 1,
      "format": "notice",
      "output": "NOTICE"
    },
    {
      "id": "license",
      "version": 1,
      "format": "license",
      "output": "LICENSE"
    }
  ]
}
